{"openapi":"3.0.0","info":{"title":"PWT API","description":"PWT Digital Platform REST API.","contact":{"name":"PWT Engineering","email":"engineering@pwt.local"},"version":"1.0.0"},"servers":[{"url":"http://127.0.0.1:8000","description":"Local development"}],"tags":[{"name":"Health","description":"Liveness and metadata endpoints"},{"name":"Reference","description":"Public lookup data: countries, regions and whitelisted application settings."},{"name":"Auth","description":"Customer authentication: OTP registration, login, password reset, logout."},{"name":"User","description":"Authenticated customer profile (self-only)."},{"name":"Addresses","description":"Customer address book for delivery destinations. Each address belongs to one customer and is scoped by ownership."},{"name":"Catalog","description":"Public read-only catalog of categories, products, images, specs, and prices. Inactive resources are filtered out of customer responses."},{"name":"Orders","description":"Customer order placement, history, tracking, and cancellation. All monetary fields are recomputed server-side; idempotent on the optional Idempotency-Key header."},{"name":"Machines","description":"Customer-owned installed filter units. Read-only for customers; admin Phase 18 manages create/edit. Includes maintenance logs and next-due date."},{"name":"Maintenance","description":"Customer maintenance requests against owned machines. Submit, list, view, and cancel-from-new. Admin assign/progress/complete lives in Phase 18."},{"name":"Support","description":"Authenticated customer support tickets — create, list, view thread, cancel. Internal admin notes are never returned to customers. Admin assign/reply lives in Phase 19."},{"name":"Contact","description":"Public guest contact-form / lead capture. No authentication. Rate-limited at 5/min/IP. The submitted `message` is never echoed back in the response."},{"name":"Admin / Users","description":"Admin lifecycle management for both admin and customer accounts